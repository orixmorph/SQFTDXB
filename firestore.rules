rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Admins Collection: Authenticated admin users
    match /admins/{adminId} {
      allow read, write: if isSignedIn();
    }

    // Blogs Collection: Public read, authenticated admin write
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Landing Pages Collection: Public read, authenticated admin write
    match /landing_pages/{pageId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
