{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator with access to the dashboard",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["superadmin", "editor"] },
        "approved": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "role", "approved", "createdAt"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Article published on the SQFT DXB blog",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "slug": { "type": "string", "maxLength": 256 },
        "category": { "type": "string", "maxLength": 64 },
        "excerpt": { "type": "string", "maxLength": 1000 },
        "content": { "type": "string", "maxLength": 50000 },
        "author": { "type": "string", "maxLength": 128 },
        "authorRole": { "type": "string", "maxLength": 128 },
        "authorPhoto": { "type": "string", "maxLength": 1024 },
        "coverImage": { "type": "string", "maxLength": 1024 },
        "published": { "type": "boolean" },
        "readTime": { "type": "string", "maxLength": 32 },
        "date": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["title", "slug", "category", "excerpt", "content", "published"]
    },
    "LandingPageConfig": {
      "title": "LandingPageConfig",
      "description": "Customizable landing page elements and campaign controls",
      "type": "object",
      "properties": {
        "pageKey": { "type": "string", "maxLength": 64 },
        "heroHeadline": { "type": "string", "maxLength": 256 },
        "heroSubheadline": { "type": "string", "maxLength": 512 },
        "bannerEnabled": { "type": "boolean" },
        "bannerText": { "type": "string", "maxLength": 256 },
        "bannerCtaText": { "type": "string", "maxLength": 64 },
        "metaTitle": { "type": "string", "maxLength": 128 },
        "metaDescription": { "type": "string", "maxLength": 512 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["pageKey"]
    },
    "InquiryLead": {
      "title": "InquiryLead",
      "description": "Property viewing requests and customer inquiries",
      "type": "object",
      "properties": {
        "propertyId": { "type": "string", "maxLength": 128 },
        "propertyTitle": { "type": "string", "maxLength": 256 },
        "propertyPrice": { "type": "number" },
        "propertyArea": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 64 },
        "date": { "type": "string", "maxLength": 64 },
        "timeSlot": { "type": "string", "maxLength": 64 },
        "message": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["new", "contacted", "scheduled", "closed"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["fullName", "phone", "status", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Approved administrators with dashboard access"
    },
    "/blogs/{blogId}": {
      "schema": { "$ref": "#/entities/BlogPost" },
      "description": "Blog posts and articles managed via dashboard"
    },
    "/landing_pages/{pageId}": {
      "schema": { "$ref": "#/entities/LandingPageConfig" },
      "description": "Landing page controls and customizable copy"
    },
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/InquiryLead" },
      "description": "Customer inquiry and viewing records"
    }
  }
}
