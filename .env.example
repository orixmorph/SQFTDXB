# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BASEROW_API_TOKEN: Private Baserow API Token.
# Configure this in the Secrets panel or server-side environment.
# Never expose this token in client-side code.
BASEROW_API_TOKEN="your_baserow_api_token_here"

# BASEROW_TABLE_ID: Baserow Table ID for Dubai property listings.
BASEROW_TABLE_ID="1210846"

# BASEROW_API_URL: Baserow API endpoint prefix.
BASEROW_API_URL="https://api.baserow.io/api/database/rows/table/"

# GOOGLE_SHEETS_WEBHOOK_URL: Server-side Google Apps Script Web App URL for multi-tab lead sync.
# Kept strictly server-side — never exposed to frontend code or client network inspection.
GOOGLE_SHEETS_WEBHOOK_URL=""
